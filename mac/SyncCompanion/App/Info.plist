<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>
    <string>com.synccompanion.mac</string>

    <key>CFBundleName</key>
    <string>MiDoid</string>

    <key>CFBundleDisplayName</key>
    <string>MiDoid</string>

    <key>CFBundleVersion</key>
    <string>1</string>

    <key>CFBundleShortVersionString</key>
    <string>1.0</string>

    <key>CFBundlePackageType</key>
    <string>APPL</string>

    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>

    <!-- Hide from Dock and App Switcher — menu bar only -->
    <key>LSUIElement</key>
    <true/>

    <!-- Minimum macOS 13 (Ventura) — required for CryptoKit Curve25519 -->
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>

    <!-- Required for NetService mDNS browsing -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>MiDoid discovers your Android phone on the local Wi-Fi network.</string>

    <!-- Bonjour service types needed for NetServiceBrowser -->
    <key>NSBonjourServices</key>
    <array>
        <string>_android-sync._tcp</string>
    </array>

    <!-- Required for sshfs process execution -->
    <key>NSAppleEventsUsageDescription</key>
    <string>MiDoid opens local Android file sessions from your Mac.</string>

    <key>NSHumanReadableCopyright</key>
    <string>Copyright © 2026 MiDoid. All rights reserved.</string>
</dict>
</plist>
